{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }} — Events</title>
    <link>{{ .Permalink }}</link>
    <description>Upcoming events for the academic open source and OSPO community, curated by CURIOSS.</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale | default "en" }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    <atom:link href="{{ "community/events/index.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{ $page := . }}
    {{ $today := now.Format "2006-01-02" }}
    {{ range sort hugo.Data.events.events "posted" "desc" }}
    {{ if and .posted .start (ge (.end | default .start) $today) }}
    {{ $anchor := printf "%s#%s" $page.Permalink (.title | anchorize) }}
    {{ $body := printf "<p><strong>%s</strong></p>" .date }}
    {{ with .location }}{{ $body = printf "%s<p>%s</p>" $body . }}{{ end }}
    {{ with .organizer }}{{ $body = printf "%s<p>Organized by %s</p>" $body . }}{{ end }}
    {{ with .description }}{{ $body = printf "%s%s" $body (. | markdownify) }}{{ end }}
    <item>
      <title>{{ .title }} — {{ .date }}{{ with .location }}, {{ . }}{{ end }}</title>
      <link>{{ .url | default $anchor }}</link>
      <pubDate>{{ (time.AsTime .posted).Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="false">{{ $anchor }}</guid>
      <description>{{ printf "<![CDATA[%s]]>" $body | safeHTML }}</description>
    </item>
    {{ end }}
    {{ end }}
  </channel>
</rss>
